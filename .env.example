# S3 存储提供者：aws 或 rustfs
S3_PROVIDER=rustfs


# ==============S3_PROVIDER = rustfs ============
# RustFS (S3 兼容) 存储服务地址（仅 rustfs 模式需要）
RUSTFS_ENDPOINT=https://***

# RustFS 访问密钥 仅 rustfs 模式需要）
RUSTFS_ACCESS_KEY=***
RUSTFS_SECRET_KEY=***
# ==============================================

# S3 存储桶名称
S3_BUCKET=***

# Speaker 资源在存储桶中的前缀
S3_SPEAKER_PREFIX=speaker/

# TTS 生成音频在存储桶中的前缀
S3_OUTPUT_PREFIX=output/

# 预签名下载链接的有效时间（秒）
PRESIGNED_EXPIRES_IN=900

# PostgreSQL 连接地址, 密码中的 URL 特殊字符需要百分号编码
DATABASE_URL=postgresql://zvox_user:CHANGE_ME@localhost:5432/zvox?sslmode=require

# VoxCPM 模型目录路径
MODEL_PATH=model/VoxCPM2

# 启动时自动下载缺失模型; 离线部署设为 false 并预先准备模型
MODEL_AUTO_DOWNLOAD=true

# ModelScope 分支或标签; 已就绪的本地模型不会自动升级
MODEL_REVISION=master

# 每位用户最多同时保留的待处理和运行中任务
MAX_ACTIVE_JOBS_PER_USER=10

# 每位用户每小时最多创建的任务
MAX_JOBS_PER_HOUR=60

# 登录滑动窗口长度和每个窗口内的尝试次数, 成功和失败均计数
LOGIN_RATE_WINDOW_SECONDS=60
LOGIN_MAX_ATTEMPTS_PER_IP=20
LOGIN_MAX_ATTEMPTS_PER_USERNAME=10

# 允许跨域访问的前端 Origin, 多个值用逗号分隔; 留空表示不开放浏览器跨域访问
CORS_ORIGINS=

# main.py 监听端口; 命令行 --port 优先
PORT=8000
